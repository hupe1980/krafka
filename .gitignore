# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Custom additions
_prompts/
API_VERSIONS.md
BACKLOG*.md
CONCEPT.md
FINDINGS.md
.DS_Store

# Zola documentation site (site/) build output.
#
# `giallo-*.css` are the syntax-highlighting themes Zola generates from
# `[markdown.highlighting]`. It writes them into `static/` — the source tree —
# rather than straight to `public/`, so they must be ignored or every build
# shows up as a diff.
site/public/
site/static/processed_images/
site/static/giallo-*.css

# Added by cargo

/target

# cargo-fuzz working state. Generated corpora are large and machine-specific;
# a curated seed corpus should be added deliberately, not accumulated here.
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# Agent worktrees and local tooling state.
.claude/

# Python bytecode from the xtask check scripts.
__pycache__/

# Generated by `just docs-test` (xtask/docs_test.py).
examples/__docs_test.rs
